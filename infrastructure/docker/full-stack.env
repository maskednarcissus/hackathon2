# Shared, non-URL settings for the full local stack (docker-compose.full.yml and
# tests/e2e/run_e2e.py --local). DEV ONLY — never reuse these secrets elsewhere.
NODE_ENV=development
LOG_LEVEL=info

# Service-to-service token (sent as x-internal-token) and its per-service aliases.
INTERNAL_API_TOKEN=dev-internal-token-change-me
INTERNAL_TOKEN=dev-internal-token-change-me
IDENTITY_INTERNAL_TOKEN=dev-internal-token-change-me
SERVICE_TOKEN=dev-internal-token-change-me
# Admin bearer for device-management / organization / notifications admin routes.
ADMIN_API_TOKEN=dev-admin-token-change-me
DEVICE_MANAGEMENT_ADMIN_TOKEN=dev-admin-token-change-me

# Audio at rest (shared by ingestion, processing and diarization): 32 bytes, base64.
AUDIO_ENCRYPTION_KEY=ZGV2LW9ubHktYXVkaW8tZW5jcnlwdGlvbi1rZXktMzI=
AUDIO_STORAGE_BACKEND=local

# Fake providers: no Google credentials needed.
TRANSCRIPTION_PROVIDER=fake
AI_GATEWAY_PROVIDER=fake
EMBEDDINGS_PROVIDER=fake
EVENT_EXTRACTOR=heuristic
EVENT_PUBLISHER=http

# Identity bootstrap admin (dev).
IDENTITY_BOOTSTRAP_ADMIN_EMAIL=admin@dev.local
IDENTITY_BOOTSTRAP_ADMIN_PASSWORD=dev-admin-password-change-me

# Analytics accepts the static internal token; local JWT checks stay on.
AUTH_DISABLED=false

# Dev event bus
BUS_MAX_ATTEMPTS=5
BUS_BACKOFF_MS=500
