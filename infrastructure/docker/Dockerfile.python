# Python service image. Build from the repository root:
#   docker build -f infrastructure/docker/Dockerfile.python --build-arg SERVICE_PATH=services/transcription .
FROM python:3.12-slim AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
ARG SERVICE_PATH
WORKDIR /build
COPY ${SERVICE_PATH}/ ./
RUN pip install --prefix=/install .

FROM python:3.12-slim AS runner
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PORT=8000
ARG SERVICE_PATH
WORKDIR /app
COPY --from=builder /install /usr/local
# main.py (uvicorn entry) plus service data such as ai-gateway prompts/.
COPY ${SERVICE_PATH}/ ./
RUN useradd --system --home /app app && chown -R app /app
USER app
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn main:app --app-dir src --host 0.0.0.0 --port ${PORT}"]
